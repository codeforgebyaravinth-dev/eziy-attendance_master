<Window x:Class="EziyAttendanceMaster.Views.FaceCameraDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Face Verification Capture" 
        Height="620" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Border Background="{StaticResource EziyNavyBrush}" CornerRadius="20" Padding="24" BorderBrush="#334155" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📸 Face Verification" FontWeight="Bold" FontSize="18" Foreground="White"/>
                    <TextBlock Text="Align your face inside the oval guide" FontSize="12" Foreground="{StaticResource EziyCyanLightBrush}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="36" Click="OnCloseClicked"
                        Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- Live Camera Preview Frame with Oval Guide -->
            <Border Grid.Row="1" Background="#020617" CornerRadius="16" ClipToBounds="True">
                <Grid>
                    <!-- Live Webcam Image View -->
                    <Image x:Name="WebcamImage" Stretch="UniformToFill"/>

                    <!-- Oval Guide Overlay Canvas -->
                    <Canvas x:Name="OverlayCanvas">
                        <Ellipse x:Name="FaceOvalGuide" Width="260" Height="340" 
                                 Stroke="#0284C7" StrokeThickness="3" StrokeDashArray="4 2"
                                 Canvas.Left="115" Canvas.Top="40"/>
                    </Canvas>

                    <!-- Instruction Chip -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                            Background="#CC0F172A" CornerRadius="20" Padding="16,8">
                        <TextBlock x:Name="TxtStatus" Text="Position face straight ahead inside oval" 
                                   Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Capture Actions -->
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <Button x:Name="BtnCapture" Style="{StaticResource PrimaryButtonStyle}" 
                        Background="{StaticResource EziyGreenBrush}"
                        Height="50" Click="OnCaptureClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📸 " FontSize="18"/>
                        <TextBlock Text="VERIFY &amp; SUBMIT ATTENDANCE" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

