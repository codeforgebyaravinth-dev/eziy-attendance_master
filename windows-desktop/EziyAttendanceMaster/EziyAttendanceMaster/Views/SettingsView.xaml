<UserControl x:Class="EziyAttendanceMaster.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:EziyAttendanceMaster.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vms:SettingsViewModel}"
             Background="{StaticResource EziyBgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="⚙️ Station Settings &amp; Configuration" FontWeight="Bold" FontSize="22" Foreground="{StaticResource EziyNavyBrush}"/>
            <TextBlock Text="Configure Odoo connection, VoIP intercom credentials &amp; station parameters" FontSize="13" Foreground="{StaticResource EziyMutedTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form Cards Container -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                <!-- Saved Toast -->
                <Border Background="#ECFDF5" BorderBrush="{StaticResource EziyGreenBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                        Visibility="{Binding IsSaved, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="✓ Settings saved and encrypted via Windows DPAPI successfully." Foreground="{StaticResource EziyGreenBrush}" FontWeight="SemiBold"/>
                </Border>

                <!-- ERP Server Card -->
                <Border Style="{StaticResource ModernCardStyle}" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🏢 ODOO ERP CONNECTION" FontWeight="Bold" FontSize="12" Foreground="{StaticResource EziyMutedTextBrush}" Margin="0,0,0,16"/>

                        <!-- Server URL -->
                        <TextBlock Text="SERVER BASE URL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EziyMutedTextBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <!-- Company Name -->
                        <TextBlock Text="ENTERPRISE COMPANY NAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EziyMutedTextBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <!-- Employee Name -->
                        <TextBlock Text="EMPLOYEE / OPERATOR NAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EziyMutedTextBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <!-- Employee Badge ID -->
                        <TextBlock Text="ASSIGNED 8-DIGIT BADGE ID (READ-ONLY)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EziyMutedTextBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding EmployeeId}" IsReadOnly="True" Background="#F1F5F9"/>
                    </StackPanel>
                </Border>

                <!-- SIP Credentials Card -->
                <Border Style="{StaticResource ModernCardStyle}" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="📞 NATIVE LINPHONE SIP EXTENSION" FontWeight="Bold" FontSize="12" Foreground="{StaticResource EziyMutedTextBrush}" Margin="0,0,0,16"/>

                        <!-- SIP Domain -->
                        <TextBlock Text="SIP PROXY / DOMAIN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EziyMutedTextBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SipDomain, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <!-- SIP Username -->
                        <TextBlock Text="SIP EXTENSION USERNAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EziyMutedTextBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SipUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <!-- SIP Password -->
                        <TextBlock Text="SIP SECRET PASSWORD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EziyMutedTextBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SipPassword, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid Margin="0,0,0,40">
                    <Button HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding SaveSettingsCommand}" Height="46" Padding="28,0">
                        <TextBlock Text="💾 Save Configuration" FontWeight="Bold" FontSize="14"/>
                    </Button>

                    <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" 
                            Background="{StaticResource EziyRedBrush}" Command="{Binding LogoutCommand}" Height="46" Padding="24,0">
                        <TextBlock Text="🚪 Disconnect &amp; Logout" FontWeight="Bold" FontSize="14"/>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

