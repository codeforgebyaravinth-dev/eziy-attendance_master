<Window x:Class="EziyAttendanceMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vms="clr-namespace:EziyAttendanceMaster.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vms:MainViewModel}"
        Title="VSPL Attendance Master — Windows Desktop Station" 
        Height="820" Width="1280"
        MinHeight="700" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource EziyBgBrush}">

    <Window.Resources>
        <!-- Nav Rail Button Style -->
        <Style x:Key="NavRailButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Navigation Rail Sidebar -->
            <ColumnDefinition Width="Auto"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Rail Sidebar (VSPL / Eziy Theme) -->
        <Border Grid.Column="0" Width="96" Background="{StaticResource EziyNavyBrush}"
                Visibility="{Binding IsNavigationRailVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Row="0" Margin="0,24,0,28" HorizontalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="10" Width="44" Height="44" HorizontalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="VSPL" FontWeight="Bold" FontSize="14" Foreground="White" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Tabs Items -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                    <!-- Home Dashboard Tab -->
                    <Button Style="{StaticResource NavRailButtonStyle}" Command="{Binding NavigateTabCommand}" CommandParameter="home">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🏢" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Home" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- History Tab -->
                    <Button Style="{StaticResource NavRailButtonStyle}" Command="{Binding NavigateTabCommand}" CommandParameter="history">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🕒" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="History" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- SIP Intercom Tab -->
                    <Button Style="{StaticResource NavRailButtonStyle}" Command="{Binding NavigateTabCommand}" CommandParameter="intercom">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📞" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Intercom" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Settings Tab -->
                    <Button Style="{StaticResource NavRailButtonStyle}" Command="{Binding NavigateTabCommand}" CommandParameter="settings">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom MQTT Push Status -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20" HorizontalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding IsMqttActive, Converter={StaticResource BoolToColorConverter}}" HorizontalAlignment="Center"/>
                    <TextBlock Text="MQTT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EziyCyanLightBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Main Viewport Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Real-Time Push Notification Alert Banner -->
            <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="0,0,0,1" Padding="16,10"
                    Visibility="{Binding GlobalAlertNotification, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <TextBlock Text="{Binding GlobalAlertNotification}" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding DismissAlertCommand}" Cursor="Hand">
                        <TextBlock Text="✕" FontWeight="Bold" Foreground="#92400E"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Dynamic Active Screen Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>

